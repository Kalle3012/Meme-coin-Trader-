# =====================================================================
#  Meme-Coin-Trader – Konfiguration
#  Kopiere diese Datei nach ".env" und passe die Werte an.
#  Die .env-Datei NIEMALS weitergeben oder auf GitHub hochladen!
# =====================================================================

# ---------------------------------------------------------------------
#  1) MODUS
# ---------------------------------------------------------------------
# true  = Papierhandel: echte Kurse, aber KEIN echtes Geld (Standard!)
# false = Live-Handel mit echtem Geld
DRY_RUN=true

# Nur für Live-Handel: muss exakt so lauten, sonst startet der Bot nicht.
# LIVE_TRADING_CONFIRM=ICH_VERSTEHE_DAS_RISIKO

# Startguthaben im Papiermodus (SOL)
PAPER_START_SOL=1
# Geschätzte Netzwerkgebühr pro Trade im Papiermodus (SOL)
PAPER_FEE_SOL=0.0001

# ---------------------------------------------------------------------
#  2) WALLET (Phantom)
# ---------------------------------------------------------------------
# Privater Schlüssel eines SEPARATEN Bot-Kontos aus Phantom:
#   Phantom -> Einstellungen -> Konten verwalten -> Bot-Konto -> "Privaten Schlüssel anzeigen"
# NIEMALS die Seed-Phrase (12/24 Wörter) und NIEMALS dein Hauptkonto verwenden!
# Für den Papiermodus ist kein Schlüssel nötig.
PRIVATE_KEY=

# Optional, aber empfohlen: öffentliche Adresse des Bot-Kontos (aus Phantom kopieren).
# Der Bot bricht ab, wenn der Schlüssel nicht zu dieser Adresse passt.
EXPECTED_WALLET_ADDRESS=

# Solana-RPC. Der öffentliche Endpunkt ist stark limitiert. Für den Live-Betrieb
# empfiehlt sich ein kostenloser Zugang bei z. B. Helius, QuickNode oder Triton.
RPC_URL=https://api.mainnet-beta.solana.com

# Optional: kostenloser API-Key von https://portal.jup.ag (mehr Anfragen pro Sekunde)
JUPITER_API_KEY=
# Anfragen pro Sekunde an Jupiter (ohne Key max. 0.5, mit Free-Key 1)
# JUPITER_RPS=0.5

# ---------------------------------------------------------------------
#  3) POSITIONSGRÖSSE & RISIKO
# ---------------------------------------------------------------------
# SOL pro Kauf
BUY_AMOUNT_SOL=0.05
# Maximal gleichzeitig offene Positionen
MAX_OPEN_POSITIONS=3
# Diese SOL-Menge bleibt immer unangetastet (Gebühren, Kontomiete, Verkäufe)
MIN_SOL_RESERVE=0.05
# Ab diesem realisierten Tagesverlust (SOL) kauft der Bot bis morgen nichts mehr
MAX_DAILY_LOSS_SOL=0.15
# Maximale Käufe pro Tag
MAX_TRADES_PER_DAY=15
# Maximale Slippage in Basispunkten (300 = 3 %). 0 = Jupiter wählt automatisch.
SLIPPAGE_BPS=300
# Maximaler Preiseinfluss eines Kaufs (%)
MAX_PRICE_IMPACT_PCT=3
# Maximaler Verlust bei simuliertem Sofort-Kauf+Verkauf (%) – Honeypot-/Steuer-Schutz
MAX_ROUNDTRIP_LOSS_PCT=8

# ---------------------------------------------------------------------
#  4) MARKT-FILTER (DexScreener)
# ---------------------------------------------------------------------
MIN_LIQUIDITY_USD=25000
MIN_MARKET_CAP_USD=75000
MAX_MARKET_CAP_USD=10000000
# Zu junge Token sind am häufigsten Rug-Pulls -> mindestens 60 Minuten alt
MIN_PAIR_AGE_MINUTES=60
MAX_PAIR_AGE_HOURS=72
MIN_VOLUME_H1_USD=15000
MIN_TXNS_H1=150
# Mehr Käufe als Verkäufe in der letzten Stunde
MIN_BUY_SELL_RATIO_H1=1.05
# Preisentwicklung 1h: positiv, aber nicht schon explodiert (kein FOMO-Kauf am Hoch)
MIN_PRICE_CHANGE_H1_PCT=0
MAX_PRICE_CHANGE_H1_PCT=100
# Nicht in einen gerade fallenden Kurs kaufen
MIN_PRICE_CHANGE_M5_PCT=-3
# Nur Token mit Website oder Social-Media-Links
REQUIRE_SOCIALS=true

# ---------------------------------------------------------------------
#  5) SICHERHEITS-FILTER (RugCheck)
# ---------------------------------------------------------------------
# RugCheck-Score 0-100 (niedriger = sicherer)
MAX_RUGCHECK_SCORE=30
# Anteil der 10 größten Holder (ohne Liquiditätspools) in %
MAX_TOP10_HOLDER_PCT=30
# Anteil des größten einzelnen Holders in %
MAX_SINGLE_HOLDER_PCT=8
# Anteil, den verbundene Insider-Wallets halten, in %
MAX_INSIDER_PCT=15
MIN_HOLDERS=300
# Token mit RugCheck-Risiken der Stufe "danger" immer ablehnen
REJECT_DANGER_RISKS=true

# ---------------------------------------------------------------------
#  6) AUSSTIEG
# ---------------------------------------------------------------------
# Bei +50 % wird ein Teil verkauft …
TAKE_PROFIT_PCT=50
# … und zwar dieser Anteil (0.5 = 50 %). Der Rest läuft mit Trailing-Stop weiter.
TAKE_PROFIT_SELL_FRACTION=0.5
# Verkauf bei -20 %
STOP_LOSS_PCT=20
# Trailing-Stop: Verkauf, wenn der Kurs 20 % unter das bisherige Hoch fällt …
TRAILING_STOP_PCT=20
# … aktiv ab +25 % Gewinn (oder nach dem Take-Profit)
TRAILING_ACTIVATION_PCT=25
# Spätestens nach dieser Zeit wird verkauft (Minuten)
MAX_HOLD_MINUTES=180

# ---------------------------------------------------------------------
#  7) TREND-RADAR (Internet-Trends, z. B. GTA 6)
# ---------------------------------------------------------------------
# Durchsucht Google News, Google Trends, Wikipedia, CoinGecko und DexScreener
# nach aktuellen Trends und bevorzugt passende Meme-Coins. ALLE Sicherheits-
# prüfungen gelten weiterhin – Trend-Coins sind besonders oft Kopien/Betrug.
TREND_ENABLED=true
# Eigene Stichwörter (Komma-getrennt). Standard: GTA 6 (Release 19.11.2026),
# Spielort Vice City / Leonida, Hauptfigur Lucia.
TREND_KEYWORDS=gta6,gta 6,gta vi,vice city,leonida,lucia
# true = NUR Coins kaufen, die zu einem Trend passen
TREND_ONLY=false
# Allgemeine Internet-Trends zusätzlich zu den Stichwörtern nutzen
TREND_INTERNET_SOURCES=true
# Länder für Google Trends
TREND_GEOS=US,DE
# Wie oft die Trends neu abgefragt werden (Minuten)
TREND_REFRESH_MIN=15
# Maximale Anzahl Token-Suchen pro Aktualisierung
TREND_MAX_SEARCHES=25
# Für Trend-Coins gelockert (nur diese zwei Werte!): Event-Coins entstehen oft
# Wochen vor dem Ereignis, ein etablierter Coin ist sicherer als eine frische Kopie.
TREND_MAX_PAIR_AGE_HOURS=2160
TREND_MAX_MARKET_CAP_USD=50000000

# ---------------------------------------------------------------------
#  8) FRÜHPHASEN-RADAR (ganz neue Coins, Minuten nach dem Start)
# ---------------------------------------------------------------------
# Sieht jeden neuen Pump.fun-Coin in Echtzeit (PumpPortal) und alle neuen Coins
# bei Jupiter, beobachtet sie einige Minuten und bewertet ihr Potenzial (0-100):
# Narrativ/Nische, Momentum, Community, Sicherheit. HÖCHSTES RISIKO im ganzen Bot:
# über 98 % der neuen Coins sterben. Darum eigenes, vorsichtiges Risikoprofil.
EARLY_ENABLED=true
# Echtzeit-Stream von PumpPortal nutzen (nur EINE Verbindung, wie vom Anbieter verlangt)
EARLY_STREAM=true
# SOL pro Frühphasen-Kauf (bewusst kleiner als normal)
EARLY_BUY_AMOUNT_SOL=0.02
# Maximal gleichzeitig offene Frühphasen-Positionen
EARLY_MAX_POSITIONS=2
# Mindest-Score für einen Kauf (0-100). Mit "npm run auswertung" prüfen und anpassen!
EARLY_MIN_SCORE=60
# Beobachtungsfenster: frühestens / spätestens so viele Minuten nach dem Start kaufen
EARLY_MIN_AGE_MINUTES=5
EARLY_MAX_AGE_MINUTES=120
EARLY_MIN_LIQUIDITY_USD=8000
EARLY_MIN_HOLDERS=40
EARLY_MAX_MARKET_CAP_USD=2000000
# Harte Ausschlüsse: Entwickler-Anteil, Top-Holder-Anteil, Massen-Launcher
EARLY_MAX_DEV_PCT=10
EARLY_MAX_TOP_HOLDERS_PCT=40
EARLY_MAX_DEV_MINTS=50
# Ausstieg für Frühphasen-Coins (stärkere Schwankungen als normal)
EARLY_STOP_LOSS_PCT=30
EARLY_TAKE_PROFIT_PCT=100
EARLY_TAKE_PROFIT_SELL_FRACTION=0.5
EARLY_TRAILING_STOP_PCT=30
EARLY_TRAILING_ACTIVATION_PCT=40
EARLY_MAX_HOLD_MINUTES=120
# Bewertungs-Intervall (Sekunden) und maximale Anzahl beobachteter Coins
EARLY_EVAL_INTERVAL_SEC=60
EARLY_WATCH_MAX=150

# ---------------------------------------------------------------------
#  9) TIMING
# ---------------------------------------------------------------------
SCAN_INTERVAL_SEC=60
POSITION_CHECK_INTERVAL_SEC=15
MAX_SAFETY_CHECKS_PER_SCAN=4
# Denselben Token nach einem Trade so lange nicht erneut kaufen (Stunden)
REBUY_COOLDOWN_HOURS=24

# Ordner für Zustand, Log und Trade-Journal
DATA_DIR=data
# Ausführliche Logs (zeigt auch Gründe für Markt-Ablehnungen)
DEBUG=false
